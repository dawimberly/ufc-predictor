# Copy to .env and fill in your keys (never commit .env)

# --- Profile ---
# paper = simulation (default) | live = real-money caps
UFC_PROFILE=paper
INITIAL_BANKROLL=75
CARD_BUDGET=12

# The Odds API — free tier primary (https://the-odds-api.com)
# Free plan is quota-limited (~500 req/mo typically). Prefer cache; refresh sparingly.
THE_ODDS_API_KEY=your_api_key_here
# Sport is forced to mma_mixed_martial_arts; free-tier defaults: regions us,eu,uk; markets h2h; decimal.
# ODDS_API_REGIONS=us,eu,uk
# ODDS_API_MARKETS=h2h
# ODDS_API_ODDS_FORMAT=decimal
# Cache live odds 15–30 minutes (default 20) when ODDS_FETCH_ONCE=false.
ODDS_CACHE_TTL_MINUTES=20
# true (default): download Odds API moneylines/props once, then reuse the cache file
# until you delete data/cache/ufc_odds_api.csv (or set ODDS_FETCH_ONCE=false).
ODDS_FETCH_ONCE=true
# PROP_MARKETS=over_1_5_rounds
# Cap Odds API prop event pulls (each event = 1 credit). Soft Update uses moneyline cache first.
# ODDS_API_PROP_MAX_EVENTS=6
# Fallback chain (free sources): Odds API → Action Network → optional books (off).
# Fail-closed: NO BET — no usable odds (fail-closed)

# Action Network UFC scoreboard (free backup scrape — fail-soft if blocked)
ACTION_NETWORK_ENABLED=true
# ACTION_NETWORK_UFC_URL=https://api.actionnetwork.com/web/v1/scoreboard/ufc

# Optional book scrapers / DK — OFF by default (enable only if you need them)
BETNOW_ENABLED=false
DRAFTKINGS_ENABLED=false
MYBOOKIE_ENABLED=false

# Optional: override public Kaggle-style odds CSV mirrors used in historical merge
# ULTIMATE_UFC_DATASET_URL=https://raw.githubusercontent.com/shortlikeafox/ultimate_ufc_dataset/main/ufc-master.csv
# JANSEN_CLEANED_ODDS_URL=https://raw.githubusercontent.com/jansen88/ufc-data/master/data/cleaned_odds.csv

# NewsAPI — https://newsapi.org (optional fight commentary sentiment)
NEWS_API_KEY=your_news_api_key_here

# Model tuning (trading-bot style Optuna search)
OPTUNA_TRIALS=50
USE_ENSEMBLE=true
ENSEMBLE_WEIGHTS=0.55,0.45
CONFORMAL_ALPHA=0.10

# Prop betting (method, rounds, decision markets)
ENABLE_PROPS=true
PROP_MIN_EDGE=0.05
PROP_SYNTHETIC_VIG=0.08
PROP_PARLAY_MAX_LEGS_DK=3
ODDS_API_PROP_MARKETS=totals

# Optional Grok narrative analysis (dashboard only — non-blocking)
GROK_ENABLED=false
# GROK_API_KEY=...   # or XAI_API_KEY
# GROK_MODEL=grok-3-mini
# Narrative Kelly tilt (model-first; Paper ±10%, Live tighter)
# GROK_KELLY_ADJ_MIN=0.90
# GROK_KELLY_ADJ_MAX=1.10
# LIVE_NARRATIVE_KELLY_MIN=0.95
# LIVE_NARRATIVE_KELLY_MAX=1.05
# NARRATIVE_TILT_ENABLED=true
# NARRATIVE_LOW_CONVICTION_FORCE_ONE=true

# Strategy rating feedback (segment Kelly clamps from settled bets)
# Paper on by default; Live requires STRATEGY_RATING_LIVE_ENABLED=true
STRATEGY_RATING_ENABLED=true
STRATEGY_RATING_LIVE_ENABLED=false
# STRATEGY_RATING_MIN_TRADES=8
# STRATEGY_RATING_LOOKBACK_DAYS=365
# STRATEGY_RATING_MULT_MIN=0.80
# STRATEGY_RATING_MULT_MAX=1.20

# Closed-loop settlement health → dynamic min-edge (Paper shorter / Live longer)
# Fail-closed: incomplete settlements never loosen thresholds
HEALTH_FEEDBACK_ENABLED=true
# PAPER_HEALTH_LOOKBACK_DAYS=90
# LIVE_HEALTH_LOOKBACK_DAYS=180
# HEALTH_MIN_SETTLED_BETS=8

# Skip-reason scorecard (journal + weekly rollup)
# SKIP_SCORECARD_LOOKBACK_DAYS=7

# Uncertainty gates (ensemble disagreement + conformal interval width)
# Fail-closed: missing metrics → skip. Paper softer; Live stricter.
UNCERTAINTY_GATES_ENABLED=true
# Paper (selective: few high-conviction singles; Live stays stricter)
# PAPER_DISAGREEMENT_SKIP=0.11
# PAPER_DISAGREEMENT_TIGHTEN=0.06
# PAPER_INTERVAL_WIDTH_SKIP=0.52
# PAPER_INTERVAL_WIDTH_TIGHTEN=0.36
# PAPER_UNCERTAINTY_EDGE_BUMP=0.025
# PAPER_UNCERTAINTY_KELLY_MULT=0.55
# PAPER_ALERT_MIN_EDGE=0.055
# PAPER_SINGLES_MIN_MODEL_PROB=0.62
# PAPER_SINGLES_MIN_CONFIDENCE=medium
# PAPER_MAX_BETS_PER_CARD=3
# LIVE_DISAGREEMENT_SKIP=0.08
# LIVE_DISAGREEMENT_TIGHTEN=0.04
# LIVE_INTERVAL_WIDTH_SKIP=0.22
# LIVE_INTERVAL_WIDTH_TIGHTEN=0.14
# LIVE_UNCERTAINTY_EDGE_BUMP=0.03
# LIVE_UNCERTAINTY_KELLY_MULT=0.45
# LIVE_ALERT_MIN_EDGE=0.09
# LIVE_SINGLES_MIN_MODEL_PROB=0.68
# LIVE_SINGLES_MIN_CONFIDENCE=high
# LIVE_MAX_BETS_PER_CARD=2

# --- Path hints (usually auto-detected; set only if needed) ---
# Canonical standalone install:
#   UFC_CANONICAL_ROOT=C:\UFC-Predictor
# Monorepo (PythonTrading) — point bot at standalone copy:
#   UFC_CANONICAL_ROOT=C:\UFC-Predictor
# Legacy monorepo sibling layout:
#   UFC_PREDICTOR_DIR=../ufc-predictor
# Optional: paste browser Cookie header when BetNow hides guest odds
# BETNOW_COOKIE=
# URL session token (appended as ?session=TOKEN on odds/prop pages)
# BETNOW_SESSION=1783704275000-1281694-...
# SESSION_TOKEN=            # alias
# BETNOW_SESSION_TOKEN=     # alias
# Auto-open BetNow/MyBookie on Refresh to capture cookies (Playwright preferred)
# Prefer the dashboard "Login on Refresh" switch, or use Capture Cookies / Login.
# COOKIE_CAPTURE_ON_REFRESH=false
# COOKIE_CAPTURE_TIMEOUT_SEC=180

# MyBookie.ag (optional — off by default; set MYBOOKIE_ENABLED=true to use)
# MYBOOKIE_ENABLED=false
# MYBOOKIE_COOKIE=
# MYBOOKIE_UFC_URL=https://www.mybookie.ag/sportsbook/ufc/
# MYBOOKIE_PROPS_URL=https://www.mybookie.ag/sportsbook/ufc/props/

# Arb Scanner (dashboard GUI — DK vs MyBookie watch + toast alerts)
# ARB_NEAR_MARGIN_PCT=3.0
# ARB_STAKE_TOTAL=100
ARB_ALERT_THRESHOLD_PCT=2.5
ARB_ALERT_POLL_SEC=45
ARB_ALERT_SOUND=true

# Alerts (optional)
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# ALERT_DRY_RUN=true
